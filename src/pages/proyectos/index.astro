---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import BuildingCard from "../../components/BuildingCard.astro";
import Cta from "../../components/Cta.astro";
import { site } from "../../data/site";
import { projects, upcoming, serviceNames } from "../../data/projects";

const filters = ["todos", ...new Set(projects.flatMap((p) => p.services))];
const schema = [
  {
    "@type": "CollectionPage",
    name: "Proyectos de Forklia",
    url: new URL("proyectos/", site.url).href,
    hasPart: projects.map((p) => ({ "@type": "CreativeWork", name: p.name, url: new URL(`proyectos/${p.slug}/`, site.url).href })),
  },
];
---

<Base
  title="En producción: proyectos reales de apps, webs y marcas | Forklia"
  description="Lyapp en la App Store, el sistema de marca de Simply Andy y el sitio de Your English Buddy: qué hicimos en cada proyecto y qué impacto tuvo."
  breadcrumbs={[{ name: "En producción", path: "proyectos/" }]}
  schema={schema}
>
  <PageHero
    eyebrow="En producción"
    title='Proyectos reales, <span class="grad-text">código real</span>'
    lead="Una app publicada en la App Store, un sistema de marca que su dueña usa a diario y un sitio educativo listo para crecer. Algunos siguen en su entorno de prueba: así se ve el trabajo mientras se cocina."
  />

  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <div class="filters" role="group" aria-label="Filtrar por servicio" data-filters data-reveal>
        {filters.map((f, i) => (
          <button type="button" class={i === 0 ? "is-on" : ""} data-filter={f} aria-pressed={i === 0 ? "true" : "false"}>
            {f === "todos" ? "Todos" : serviceNames[f]}
          </button>
        ))}
      </div>
      <div class="pgrid">
        {projects.map((p, i) => <div class="pgrid__item" data-cat={p.services.join(" ")}><ProjectCard project={p} delay={(i % 2) * 100} /></div>)}
        {upcoming.map((u, i) => <div class="pgrid__item" data-cat="upcoming"><BuildingCard name={u.name} category={u.category} note={u.note} delay={i * 100} /></div>)}
      </div>
    </div>
  </section>

  <Cta title='Quieres que el próximo <span class="grad-text">sea el tuyo</span>?' />
</Base>
