---
import Base from "../layouts/Base.astro";
import ServicesBento from "../components/ServicesBento.astro";
import Testimonials from "../components/Testimonials.astro";
import AndyEffect from "../components/AndyEffect.astro";
import BuddyEffect from "../components/BuddyEffect.astro";
import LyappScrolly from "../components/LyappScrolly.astro";
import BuildingCard from "../components/BuildingCard.astro";
import PostCard from "../components/PostCard.astro";
import Cta from "../components/Cta.astro";
import { site, tech, posts } from "../data/site";
import { projects, upcoming } from "../data/projects";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const andy = projects.find((p) => p.slug === "simply-andy")!;
const buddy = projects.find((p) => p.slug === "your-english-buddy")!;
const schema = [
  {
    "@type": "ItemList",
    name: "Proyectos de Forklia",
    itemListElement: projects.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: new URL(`proyectos/${p.slug}/`, site.url).href,
      name: p.name,
    })),
  },
];
---

<Base schema={schema} fonts="&family=Playfair+Display:wght@500;600&family=Archivo:wght@700&family=DM+Mono">
  <!-- ═════════════ HERO ═════════════ -->
  <header class="hero" id="top">
    <a href={`${base}proyectos/lyapp/`} class="badge" data-reveal>
      <span class="badge__tag"><span class="dot"></span>Nuevo</span>
      Lyapp ya está en la App Store →
    </a>
    <h1 data-split>Construimos productos digitales que <span class="grad-text">crecen contigo</span></h1>
    <p class="lead" data-reveal style="--d:200ms">
      Diseñamos y desarrollamos sitios web, apps móviles y estrategias de posicionamiento que llevan a tu marca a lo más alto de los buscadores y al corazón de tus clientes.
    </p>
    <div class="hero__ctas" data-reveal style="--d:300ms">
      <a href={`${base}cotizar/`} class="btn btn--primary" data-magnetic>Iniciar proyecto <span class="arrow">→</span></a>
      <a href="#proyectos" class="btn btn--ghost" data-magnetic>Ver proyectos reales</a>
    </div>
    <div data-reveal style="--d:380ms">
      <div class="cli">
        <span class="cli__prompt">$</span>
        <span class="cli__cmd" data-type-loop='["forklia init tu-marca","forklia design --bold","forklia deploy --prod","forklia grow --seo"]'></span>
        <button type="button" data-copy aria-label="Copiar comando">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
        </button>
      </div>
    </div>

    <div class="stage" data-reveal style="--d:450ms">
      <div class="stage__glow"></div>
      <div class="float-chip chip-a" data-parallax="-0.08">
        <div><span class="float-chip__ic ic-green">✓</span><span>Deploy exitoso<small>prod · hace 2s</small></span></div>
      </div>
      <div class="float-chip chip-b" data-parallax="0.1">
        <div><span class="float-chip__ic ic-cyan">↑</span><span>Lighthouse 100<small>perf · a11y · seo</small></span></div>
      </div>
      <div class="float-chip chip-c" data-parallax="-0.05">
        <div><span class="float-chip__ic ic-violet">★</span><span>Nuevo lead calificado<small>desde Google · orgánico</small></span></div>
      </div>
      <div class="stage__tilt" id="hero-tilt">
        <div class="window" data-inview>
          <div class="window__bar">
            <div class="window__dots"><i></i><i></i><i></i></div>
            <div class="window__url"><b>●</b> app.orbit.io/overview</div>
          </div>
          <div class="dash">
            <aside class="dash__side">
              <div class="dash__logo"><i></i>Orbit</div>
              <div class="dash__item is-on"><i></i>Overview</div>
              <div class="dash__item"><i></i>Clientes <em>12</em></div>
              <div class="dash__item"><i></i>Campañas</div>
              <div class="dash__item"><i></i>Contenido</div>
              <div class="dash__item"><i></i>Integraciones</div>
              <div class="dash__item"><i></i>Ajustes</div>
            </aside>
            <div class="dash__main">
              <div class="dash__top">
                <h4>Buenos días, equipo 👋</h4>
                <small><span class="dot dot--green"></span>En vivo</small>
              </div>
              <div class="kpi"><span>Visitantes</span><strong data-count="48210">0</strong><small>▲ 32.4%</small></div>
              <div class="kpi"><span>Conversión</span><strong><span data-count="6.8" data-dec="1">0</span>%</strong><small>▲ 2.1 pts</small></div>
              <div class="kpi"><span>Ingresos</span><strong>$<span data-count="92">0</span>K</strong><small>▲ 18%</small></div>
              <div class="chart">
                <header><span>Tráfico orgánico · 12 meses</span><span class="mono">+214%</span></header>
                <svg viewBox="0 0 400 150" preserveAspectRatio="none" aria-hidden="true">
                  <defs>
                    <linearGradient id="lg" x1="0" x2="1"><stop offset="0" stop-color="#45E0FF" /><stop offset="1" stop-color="#9B6BFF" /></linearGradient>
                    <linearGradient id="ag" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="rgba(69,224,255,.28)" /><stop offset="1" stop-color="rgba(69,224,255,0)" /></linearGradient>
                  </defs>
                  <path class="area" d="M0 130 C40 125 60 118 90 112 S150 110 180 92 S240 88 270 64 S330 50 360 30 L400 18 L400 150 L0 150Z"></path>
                  <path class="line" d="M0 130 C40 125 60 118 90 112 S150 110 180 92 S240 88 270 64 S330 50 360 30 L400 18"></path>
                </svg>
              </div>
              <div class="feed">
                <header><span>Actividad</span><span class="dot"></span></header>
                <div class="feed__list" id="feed"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="stats" data-reveal>
      <div class="stat"><strong class="grad-text"><span data-count="48" data-suffix="h">0</span></strong><span>Para recibir tu propuesta</span></div>
      <div class="sep"></div>
      <div class="stat"><strong class="grad-text"><span data-count="100" data-suffix="%">0</span></strong><span>Remoto, desde cualquier país</span></div>
      <div class="sep"></div>
      <div class="stat"><strong class="grad-text">ES · EN</strong><span>Trabajamos en tu idioma</span></div>
    </div>
  </header>

  <div class="marquee" style="margin-top: clamp(64px, 10vh, 110px);" aria-label="Tecnologías que usamos">
    <div class="marquee__track">
      {[...tech, ...tech].map((t, i) => <span aria-hidden={i >= tech.length ? "true" : undefined}>{t}</span>)}
    </div>
  </div>

  <!-- ═════════════ TESTIMONIOS ═════════════ -->
  <section class="section" id="testimonios" aria-labelledby="t-title">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow eyebrow--violet" data-reveal>// lo que dicen</div>
        <h2 class="h2" id="t-title" data-split>Personas reales, productos reales</h2>
      </div>
    </div>
    <Testimonials />
  </section>

  <!-- ═════════════ SUPERPODERES ═════════════ -->
  <section id="superpoderes" class="section" style="padding-top: 0;" aria-labelledby="s-title">
    <div class="wrap">
      <div class="section-head section-head--row">
        <div style="max-width: 640px;">
          <div class="eyebrow" data-reveal>// superpoderes</div>
          <h2 class="h2" id="s-title" data-split>Cuatro formas de hacer crecer tu marca</h2>
        </div>
        <a href={`${base}soluciones/`} class="link-arrow" data-reveal>Ver cada superpoder <span>→</span></a>
      </div>
      <ServicesBento />
    </div>
  </section>

  <!-- ═════════════ EN PRODUCCIÓN ═════════════ -->
  <section id="proyectos" class="section" style="padding-bottom: 0;" aria-labelledby="p-title">
    <div class="wrap">
      <div class="section-head section-head--row">
        <div style="max-width: 640px;">
          <div class="eyebrow" data-reveal>// en producción</div>
          <h2 class="h2" id="p-title" data-split>Proyectos reales, cada uno con su propio pulso</h2>
          <p class="lead" data-reveal style="--d:120ms">Interactúa con ellos: cada proyecto se presenta con un efecto de su propio mundo.</p>
        </div>
        <a href={`${base}proyectos/`} class="link-arrow" data-reveal>Todos los proyectos <span>→</span></a>
      </div>

      <article class="feat" aria-labelledby="feat-andy">
        <div class="feat__copy" data-reveal>
          <div class="proj-tag"><span class="proj-tag__sq" style="--sq:#864C24"></span><span>{andy.category}</span><em>{andy.status}</em></div>
          <h3 id="feat-andy">{andy.name}: una marca con la que se puede <span class="andy-grad">jugar</span></h3>
          <p>{andy.summary}</p>
          <ul class="feat__list">
            <li>Paleta de 7 colores con nombre y rol</li>
            <li>Logo en 3 fondos aprobados</li>
            <li>Generador de firma de correo</li>
          </ul>
          <div class="feat__ctas">
            <a href={`${base}proyectos/${andy.slug}/`} class="btn btn--ghost btn--sm" data-magnetic>Ver el caso <span class="arrow">→</span></a>
            <span class="feat__try">prueba los colores →</span>
          </div>
        </div>
        <div data-reveal style="--d:120ms"><AndyEffect /></div>
      </article>

      <article class="feat feat--rev" aria-labelledby="feat-buddy">
        <div class="feat__copy" data-reveal>
          <div class="proj-tag"><span class="proj-tag__sq" style="--sq:#185C60"></span><span>{buddy.category}</span><em>{buddy.status}</em></div>
          <h3 id="feat-buddy">{buddy.name}: inglés para la <span class="buddy-grad">vida real</span></h3>
          <p>{buddy.summary}</p>
          <ul class="feat__list">
            <li>Recorrido hacia la clase diagnóstica</li>
            <li>Historias reales de estudiantes</li>
            <li>Conversión directa por WhatsApp</li>
          </ul>
          <div class="feat__ctas">
            <a href={`${base}proyectos/${buddy.slug}/`} class="btn btn--ghost btn--sm" data-magnetic>Ver el caso <span class="arrow">→</span></a>
          </div>
        </div>
        <div data-reveal style="--d:120ms"><BuddyEffect /></div>
      </article>
    </div>
  </section>

  <LyappScrolly />

  <section class="section" style="padding-top: clamp(24px, 4vh, 48px);" aria-label="Próximos proyectos">
    <div class="wrap">
      <div class="upcoming">
        {upcoming.map((u, i) => <BuildingCard name={u.name} category={u.category} note={u.note} delay={i * 100} />)}
      </div>
    </div>
  </section>

  <!-- ═════════════ BITÁCORA ═════════════ -->
  <section id="bitacora" class="section" style="padding-top: 0;" aria-labelledby="b-title">
    <div class="wrap">
      <div class="section-head section-head--row">
        <div style="max-width: 580px;">
          <div class="eyebrow" data-reveal>// bitácora</div>
          <h2 class="h2" id="b-title" data-split>Lo que aprendemos construyendo</h2>
        </div>
        <a href={`${base}blog/`} class="link-arrow" data-reveal>Toda la bitácora <span>→</span></a>
      </div>
      <div class="posts">
        {posts.slice(0, 3).map((p, i) => <PostCard post={p} delay={i * 90} />)}
      </div>
    </div>
  </section>

  <Cta />
</Base>
