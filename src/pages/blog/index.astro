---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import PostCard from "../../components/PostCard.astro";
import Cta from "../../components/Cta.astro";
import { posts } from "../../data/site";

const categories = ["Todos", ...new Set(posts.map((p) => p.category))];
const [featured, ...rest] = posts;
---

<Base
  title="Bitácora: guías de apps, webs, SEO y marca | Forklia"
  description="La bitácora de Forklia: lo que aprendemos construyendo apps, sitios web, estrategias SEO y sistemas de marca. Guías prácticas, sin humo."
  breadcrumbs={[{ name: "Bitácora", path: "blog/" }]}
>
  <PageHero
    eyebrow="Bitácora"
    title='El changelog de <span class="grad-text">lo que aprendemos</span>'
    lead="Lo que aprendemos construyendo productos digitales, contado sin humo. Contenido de ejemplo mientras publicamos los primeros artículos."
  />

  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <div class="filters" role="group" aria-label="Filtrar por categoría" data-filters data-reveal>
        {categories.map((c, i) => <button type="button" class={i === 0 ? "is-on" : ""} data-filter={c} aria-pressed={i === 0 ? "true" : "false"}>{c}</button>)}
      </div>
      <div class="posts">
        <PostCard post={featured} feature />
        {rest.map((p, i) => <PostCard post={p} delay={(i % 3) * 90} />)}
      </div>
    </div>
  </section>

  <Cta title='Tienes un proyecto <span class="grad-text">en mente</span>?' />
</Base>
