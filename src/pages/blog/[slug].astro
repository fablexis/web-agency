---
import PostView from "../../views/Post.astro";
import Redirect from "../../components/Redirect.astro";
import { posts } from "../../data/site";

export function getStaticPaths() {
  return [
    ...posts.map((post) => ({ params: { slug: post.slug.en }, props: { post, legacy: false } })),
    // old Spanish URLs lived under /blog/
    ...posts.map((post) => ({ params: { slug: post.slug.es }, props: { post, legacy: true } })),
  ];
}
const { post, legacy } = Astro.props;
---

{legacy ? <Redirect to={`es/blog/${post.slug.es}/`} /> : <PostView lang="en" post={post} />}
