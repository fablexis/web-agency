---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Cta from "../components/Cta.astro";
import { site, founders } from "../data/site";
import { route, loc, base, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const other: Lang = lang === "en" ? "es" : "en";
const people = loc(founders, lang) as any[];
const c = {
  en: {
    title: "git blame: the people behind Forklia's code | Forklia",
    desc: "Meet Fabián Pernía, Full Stack Engineer, and Fabio Pernía, Creative Director and Head of Sales: the founders of Forklia, a remote app, web and brand studio.",
    eyebrow: "// git blame", crumb: "git blame",
    h1: 'The minds behind <span class="grad-text">the code</span>',
    lead: "A product studio founded by two complementary profiles: end-to-end engineering and creative direction with a commercial eye.",
    manifesto: "We believe great digital products are born when engineering and creativity share the same table from day one. That's why Forklia is small on purpose: you talk directly with the people who design, build and grow what you imagine.",
    how: "// how we work", howT: "Principles we don't compromise on",
    values: [["Obsessed with detail", "Every pixel and every millisecond counts."], ["Full transparency", "Visible progress, fixed prices, no surprises."], ["Business first", "We design for metrics, not just awards."], ["Long-term partners", "Launch is the start, not the finish line."]],
    ctaT: 'Shall we build something <span class="grad-text">together</span>?', ctaText: "Book a call with the founders and tell us what you want to achieve.",
    photo: "Black and white portrait of",
    whatT: "Forklia is a two-person product studio",
    what: "Forklia designs and codes mobile apps, websites, SEO and GEO, and brand systems. The studio is remote, works in English and Spanish, and the people on this page are the ones who do the work.",
    facts: [
      ["Who builds", "Fabián Pernía architects each product, from the database to the last interaction."],
      ["Who directs", "Fabio Pernía sets how the work looks, feels and gets sold."],
      ["Where", "Fully remote. Meetings follow the client's time zone, in English or Spanish."],
      ["A public ship", "Lyapp, a baby tracker, is live on the App Store. Simply Andy and Your English Buddy are the other published cases."],
    ],
  },
  es: {
    title: "git blame: las mentes detrás del código de Forklia | Forklia",
    desc: "Fabián Pernía, ingeniería, y Fabio Pernía, dirección creativa: los fundadores de Forklia, estudio remoto de apps, webs y marcas.",
    eyebrow: "// git blame", crumb: "git blame",
    h1: 'Las mentes detrás <span class="grad-text">del código</span>',
    lead: "Un estudio de producto digital fundado por dos perfiles complementarios: ingeniería de punta a punta y dirección creativa con visión comercial.",
    manifesto: "Creemos que un gran producto digital nace cuando ingeniería y creatividad se sientan en la misma mesa desde el primer día. Por eso Forklia es pequeño a propósito: hablas directamente con quienes diseñan, construyen y hacen crecer lo que imaginas.",
    how: "// cómo trabajamos", howT: "Principios que no negociamos",
    values: [["Obsesión por el detalle", "Cada píxel y cada milisegundo cuentan."], ["Transparencia total", "Avances visibles, precios cerrados, sin sorpresas."], ["Negocio primero", "Diseñamos para métricas, no solo para premios."], ["Socios a largo plazo", "Lanzar es el inicio, no la meta."]],
    ctaT: '¿Construimos algo <span class="grad-text">juntos</span>?', ctaText: "Agenda una llamada con los fundadores y cuéntanos qué quieres lograr.",
    photo: "Retrato en blanco y negro de",
    whatT: "Forklia es un estudio de producto de dos personas",
    what: "Forklia diseña y programa apps móviles, sitios web, SEO y GEO, y sistemas de marca. El estudio es remoto, trabaja en español e inglés, y las personas de esta página son quienes hacen el trabajo.",
    facts: [
      ["Quién construye", "Fabián Pernía diseña la arquitectura de cada producto, de la base de datos a la última interacción."],
      ["Quién dirige", "Fabio Pernía define cómo se ve, se siente y se vende el trabajo."],
      ["Dónde", "100% remoto. Las reuniones siguen la zona horaria del cliente, en español o en inglés."],
      ["Un lanzamiento público", "Lyapp, un registro para bebés, está en la App Store. Simply Andy y Your English Buddy son los otros casos publicados."],
    ],
  },
}[lang];
const aboutUrl = new URL(route("about", lang), site.url).href;
const schema = [{ "@type": "AboutPage", name: c.title, url: aboutUrl, mainEntity: people.map((f) => ({ "@type": "Person", "@id": `${aboutUrl}#${f.initials.toLowerCase()}`, name: f.name, jobTitle: f.jobTitle, url: `${aboutUrl}#${f.initials.toLowerCase()}`, image: new URL(f.photo, site.url).href, worksFor: { "@id": new URL("#organization", site.url).href } })) }];
---

<Base lang={lang} alt={route("about", other)} title={c.title} description={c.desc} type="profile" breadcrumbs={[{ name: c.crumb, path: route("about", lang) }]} schema={schema}>
  <PageHero lang={lang} eyebrow={c.eyebrow} crumb={c.crumb} title={c.h1} lead={c.lead} violet />
  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <article class="card roster" data-reveal data-spotlight>
        {people.map((f) => {
          const id = f.initials.toLowerCase();
          return (
            <div class="roster__person" id={id}>
              <img class="roster__photo" src={base + f.photo} alt={`${c.photo} ${f.name}, ${f.jobTitle} — Forklia`} width="880" height="1172" loading="lazy" decoding="async" />
              <div class="roster__copy">
                <h2>{f.name}</h2>
                <p class="roster__role">{f.role}</p>
                <p>{f.bio}</p>
                <ul class="tags">
                  {f.skills.map((sk: string) => <li class="tag">{sk}</li>)}
                </ul>
              </div>
            </div>
          );
        })}
      </article>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <p class="manifesto" data-manifesto>{c.manifesto.split(" ").map((w) => <span>{w} </span>)}</p>
      <div class="section-head" style="margin-top: 64px;"><h2 class="h2" data-split>{c.whatT}</h2></div>
      <p class="lead" data-reveal>{c.what}</p>
      <dl class="facts">
        {c.facts.map(([term, text]) => <div data-reveal><dt>{term}</dt><dd>{text}</dd></div>)}
      </dl>
    </div>
  </section>
  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <div class="section-head"><div class="eyebrow" data-reveal>{c.how}</div><h2 class="h2" data-split>{c.howT}</h2></div>
      <div class="cfg" data-cfg data-reveal>
        <div class="mapp__bar"><span class="window__dots"><i></i><i></i><i></i></span><span class="mapp__title"><b>forklia.config.ts</b><small>// principles</small></span></div>
        <div class="cfg__body">
          <div class="cfg__ln"><span class="k">export default</span> {"{"}</div>
          {c.values.map(([t, d], i) => {
            const key = ["detail", "transparency", "businessFirst", "longTerm"][i];
            return (
              <button type="button" class="cfg__row" data-cfg-row aria-pressed="false" style={`--i:${i}`}>
                <span class="cfg__key">{key}</span><span class="cfg__colon">:</span>
                <span class="cfg__switch" aria-hidden="true"><i></i></span>
                <span class="cfg__val" data-cfg-val>false</span><span class="cfg__colon">,</span>
                <span class="cfg__doc"><b>{t}</b><small>// {d}</small></span>
              </button>
            );
          })}
          <div class="cfg__ln">{"};"}</div>
        </div>
      </div>
    </div>
  </section>
  <Cta lang={lang} title={c.ctaT} text={c.ctaText} />
</Base>
