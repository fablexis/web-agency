---
import { ui, href, base, srcset2x, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];

const c = {
  en: {
    badge: "New", badgeText: "Lyapp is live on the App Store",
    cmd: "forklia build --from idea --to product",
    h1a: "Ideas in.", h1b: "Products out.", code: "ideas.map(build)",
    lead: "Forklia is a remote studio that designs and codes apps, websites, SEO and brand systems for teams anywhere in the world.",
    see: "See shipped work",
    chips: [["Build passed", "prod · 2s ago"], ["Lighthouse 100", "perf · a11y · seo"], ["Shipped to App Store", "Lyapp · v1.1"]],
    compiling: "compiling…", compiled: "compiled in", hot: "hot reload",
    proj: [["Lyapp", "Live on the App Store", "View case"], ["Your English Buddy", "Website · in staging", "View case"], ["Simply Andy", "Brand system · in staging", "View case"]],
  },
  es: {
    badge: "Nuevo", badgeText: "Lyapp ya está en la App Store",
    cmd: "forklia build --desde idea --hasta producto",
    h1a: "Entra una idea.", h1b: "Sale un producto.", code: "idea.compilar()",
    lead: "Forklia es un estudio remoto que diseña y programa apps, sitios web, SEO y sistemas de marca para equipos de cualquier país.",
    see: "Ver proyectos reales",
    chips: [["Build exitoso", "prod · hace 2s"], ["Lighthouse 100", "perf · a11y · seo"], ["Publicada en App Store", "Lyapp · v1.1"]],
    compiling: "compilando…", compiled: "compilado en", hot: "hot reload",
    proj: [["Lyapp", "Disponible en App Store", "Ver caso"], ["Your English Buddy", "Sitio web · en prueba", "Ver caso"], ["Simply Andy", "Sistema de marca · en prueba", "Ver caso"]],
  },
}[lang];

const scenes = [
  {
    file: "lyapp/Today.tsx", slug: "lyapp",
    code: [
      `<span class="k">export default function</span> <span class="f">Today</span>() {`,
      `  <span class="k">return</span> &lt;<span class="t">Screen</span> title=<span class="s">"Lua · 14 months"</span>&gt;`,
      `    &lt;<span class="t">SleepRing</span> hours={<span class="n">12.5</span>} range=<span class="s">"11–14h"</span> /&gt;`,
      `    &lt;<span class="t">Button</span> title=<span class="s">"Start sleep timer"</span> onPress={<span class="f">timer.start</span>} /&gt;`,
      `    &lt;<span class="t">LiveActivity</span> island=<span class="s">"sleep"</span> /&gt;`,
      `    &lt;<span class="t">Tiles</span> items={[<span class="s">"feed"</span>, <span class="s">"calendar"</span>]} /&gt;`,
      `  &lt;/<span class="t">Screen</span>&gt;;`,
    ],
    reveal: [0.16, 0.3, 0.46, 0.62, 0.76, 0.9, 1],
    spots: [null, [6, 26, 70, 7, "<Screen>"], [19, 45, 27, 14, "<SleepRing>"], [19, 58.3, 62, 5.5, "<Button>"], [37, 22, 26, 4, "<LiveActivity>"], [18, 66, 64, 27, "<Tiles>"], null],
  },
  {
    file: "english-buddy/Home.tsx", slug: "your-english-buddy",
    code: [
      `<span class="k">export default function</span> <span class="f">Home</span>() {`,
      `  <span class="k">return</span> &lt;<span class="t">Page</span> lang=<span class="s">"es"</span>&gt;`,
      `    &lt;<span class="t">Nav</span> cta=<span class="s">"Contacto"</span> /&gt;`,
      `    &lt;<span class="t">Badge</span>&gt;Clase diagnóstica personalizada&lt;/<span class="t">Badge</span>&gt;`,
      `    &lt;<span class="t">Hero</span> title=<span class="s">"Bienvenido a Your English Buddy"</span> /&gt;`,
      `    &lt;<span class="t">Cta</span> href=<span class="s">"/diagnostico"</span>&gt;Empieza mi viaje&lt;/<span class="t">Cta</span>&gt;`,
      `  &lt;/<span class="t">Page</span>&gt;;`,
    ],
    reveal: [0.04, 0.1, 0.16, 0.3, 0.52, 0.8, 1],
    spots: [null, [0, 9, 100, 91, "<Page>"], [1, 0.5, 98, 8.5, "<Nav>"], [9, 17.5, 19, 6, "<Badge>"], [9, 24, 39, 17, "<Hero>"], [9, 59.5, 25, 8, "<Cta>"], null],
  },
  {
    file: "simply-andy/brand.css", slug: "simply-andy",
    code: [
      `<span class="t">:root</span> {`,
      `  <span class="v">--eggshell</span>: <span class="n">#E9E2D0</span>;`,
      `  <span class="v">--cuero</span>: <span class="n">#864C24</span>;`,
      `  <span class="v">--indigo</span>: <span class="n">#1F2C44</span>;`,
      `  <span class="v">--head</span>: <span class="s">"Big Shoulders"</span>;`,
      `}`,
      `<span class="t">.hero</span> { <span class="k">background</span>: <span class="f">var</span>(<span class="v">--cuero</span>); }`,
    ],
    reveal: [0.08, 0.2, 0.36, 0.5, 0.7, 0.84, 1],
    spots: [null, [9, 1, 82, 8, "--eggshell"], [3, 20, 50, 58, "--cuero"], [10, 80.5, 15.5, 7, "--indigo"], [10, 25, 41, 27, "--head"], null, [62, 12, 32, 85, ".hero"]],
  },
];
const shots = ["projects/lyapp-hoy.webp", "projects/your-english-buddy.webp", "projects/simply-andy-portfolio.webp"];
---

<header class="hero2" id="top">
  <div class="hero2__float" aria-hidden="true">
    {[
      ["<App />", "f1"], ["useState(idea)", "f2"], ["</>", "f3"], ["git push origin main", "f4"],
      ["fetch('/api/launch')", "f5"], ["{ ...brand }", "f6"], ["<View>", "f7"], ["npm run build", "f8"],
      [".map(build)", "f9"], ["=> deploy()", "f10"], ["@media (max-width: 640px)", "f11"], ["200 OK", "f12"],
    ].map(([t, k]) => <span class={`fcode ${k}`} data-depth={k.length % 3 + 1}>{t}</span>)}
  </div>
  <div class="hero2__in">
    <a href={href("case", lang, "lyapp")} class="badge" data-reveal>
      <span class="badge__tag"><span class="dot"></span>{c.badge}</span>{c.badgeText} →
    </a>
    <div class="hero2__cmd" aria-hidden="true"><span class="tk tk--p">$</span> <span data-hero-cmd data-text={c.cmd}>{c.cmd}</span><i class="hero2__caret"></i></div>
    <h1 class="hero2__h1" data-hero-h1>
      <span class="h1-tag" aria-hidden="true">&lt;h1&gt;</span>
      <span class="hero2__l1" data-type>{c.h1a}</span>
      <span class="hero2__l2 grad-text" data-compile data-src={c.code}>{c.h1b}</span>
      <span class="h1-tag h1-tag--end" aria-hidden="true">&lt;/h1&gt;</span>
    </h1>
    <p class="lead" data-reveal style="--d:300ms">{c.lead}</p>
    <div class="hero__ctas" data-reveal style="--d:380ms">
      <a href={href("start", lang)} class="btn btn--primary" data-magnetic>{t.start} <span class="arrow">→</span></a>
      <a href="#proyectos" class="btn btn--ghost" data-magnetic>{c.see}</a>
    </div>
  </div>

  <div class="stage" data-reveal style="--d:450ms">
    <div class="stage__glow"></div>
    {c.chips.map(([a, b], i) => (
      <div class={`float-chip chip-${"abc"[i]}`} data-parallax="0">
        <div><span class={`float-chip__ic ${["ic-green", "ic-cyan", "ic-violet"][i]}`}>{["✓", "↑", "★"][i]}</span><span>{a}<small>{b}</small></span></div>
      </div>
    ))}
    <div class="stage__tilt" id="hero-tilt">
      <div class="live window" data-live data-scenes={JSON.stringify(scenes)} data-i18n={JSON.stringify({ compiling: c.compiling, compiled: c.compiled, hot: c.hot })} aria-hidden="true">
        <div class="window__bar">
          <div class="window__dots"><i></i><i></i><i></i></div>
          <div class="win-tabs live__tabs" data-live-tabs>{scenes.map((sc, i) => <button type="button" tabindex="-1" class={i === 0 ? "is-on" : undefined} data-tab={i}>{sc.file}<i class="live__tabprog"></i></button>)}</div>
          <span class="live__status" data-live-status><i></i>{c.compiling}</span>
        </div>
        <div class="live__body">
          <pre class="live__code" data-live-code></pre>
          <div class="live__preview" data-live-preview>
            {scenes.map((sc, i) => (
              <div class={`live__scene${i === 0 ? " is-on" : ""}`} data-scene={i}>
                <div class={`pv-frame ${i === 0 ? "pv-frame--phone" : "pv-frame--web"}`} style="--rv:0">
                  {i > 0 && <div class="pv-frame__bar"><i></i><i></i><i></i><span>{["", "your-english-buddy.app", "simply-andy.ugc"][i]}</span></div>}
                  <div class="pv-frame__view">
                    <div class="pv-blueprint"></div>
                    <img class="pv-shot" src={base + shots[i]} srcset={srcset2x(shots[i])} alt="" width={i === 0 ? 600 : 1280} height={i === 0 ? 1298 : 800} loading="eager" decoding="async" />
                    <div class="pv-spots">{sc.spots.map((sp: any, li: number) => sp && <span class="pv-spot" data-line={li} style={`left:${sp[0]}%;top:${sp[1]}%;width:${sp[2]}%;height:${sp[3]}%`}><em>{sp[4]}</em></span>)}</div>
                    <i class="pv-flash"></i>
                  </div>
                </div>
                <a class="pv-proj" href={href("case", lang, sc.slug)} tabindex="-1">
                  <span class="pv-proj__dot"></span><b>{c.proj[i][0]}</b><small>{c.proj[i][1]}</small><em>{c.proj[i][2]} →</em>
                </a>
              </div>
            ))}
            <div class="live__wipe" data-live-wipe></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
