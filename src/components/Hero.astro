---
import { ui, href, base, srcset2x, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];

const c = {
  en: {
    badge: "New", badgeText: "Lyapp is live on the App Store",
    cmd: "forklia build --from idea --to product",
    h1a: "Ideas in.", h1b: "Products out.", code: "ideas.map(build)",
    lead: "Forklia is a remote studio that designs and codes apps, websites, SEO and brand systems for teams anywhere in the world.",
    see: "See shipped work",
    chips: [["Build passed", "prod · 2s ago"], ["Lighthouse 100", "perf · a11y · seo"], ["Shipped to App Store", "Lyapp · v1.1"]],
    compiling: "compiling…", compiled: "compiled in", hot: "hot reload",
    proj: [["Lyapp", "Live on the App Store", "View case"], ["Your English Buddy", "Website · in staging", "View case"], ["Simply Andy", "Brand system · in staging", "View case"]],
  },
  es: {
    badge: "Nuevo", badgeText: "Lyapp ya está en la App Store",
    cmd: "forklia build --desde idea --hasta producto",
    h1a: "Entra una idea.", h1b: "Sale un producto.", code: "idea.compilar()",
    lead: "Forklia es un estudio remoto que diseña y programa apps, sitios web, SEO y sistemas de marca para equipos de cualquier país.",
    see: "Ver proyectos reales",
    chips: [["Build exitoso", "prod · hace 2s"], ["Lighthouse 100", "perf · a11y · seo"], ["Publicada en App Store", "Lyapp · v1.1"]],
    compiling: "compilando…", compiled: "compilado en", hot: "hot reload",
    proj: [["Lyapp", "Disponible en App Store", "Ver caso"], ["Your English Buddy", "Sitio web · en prueba", "Ver caso"], ["Simply Andy", "Sistema de marca · en prueba", "Ver caso"]],
  },
}[lang];

const deck = [
  { slug: "lyapp", kind: "phone", name: "Lyapp", tag: "Lyapp", accent: "#E8805A", status: c.proj[0][1], cmd: "deploy lyapp", shots: ["projects/lyapp-hoy.webp", "projects/lyapp-resumen.webp", "projects/lyapp-coach.webp"] },
  { slug: "your-english-buddy", kind: "web", name: "Your English Buddy", tag: "EnglishBuddy", accent: "#3DDC84", status: c.proj[1][1], cmd: "deploy english-buddy", url: "fabio-english-academy.vercel.app", page: "projects/your-english-buddy-page.webp", h: 1799 },
  { slug: "simply-andy", kind: "web", name: "Simply Andy", tag: "SimplyAndy", accent: "#C9824F", status: c.proj[2][1], cmd: "deploy simply-andy", url: "simply-andy.ugc", page: "projects/simply-andy-page.webp", h: 1150 },
];
---

<header class="hero2" id="top">
  <div class="hero2__float" aria-hidden="true">
    {[
      ["<App />", "f1"], ["useState(idea)", "f2"], ["</>", "f3"], ["git push origin main", "f4"],
      ["fetch('/api/launch')", "f5"], ["{ ...brand }", "f6"], ["<View>", "f7"], ["npm run build", "f8"],
      [".map(build)", "f9"], ["=> deploy()", "f10"], ["@media (max-width: 640px)", "f11"], ["200 OK", "f12"],
    ].map(([t, k]) => <span class={`fcode ${k}`} data-depth={k.length % 3 + 1}>{t}</span>)}
  </div>
  <div class="hero2__in">
    <a href={href("case", lang, "lyapp")} class="badge" data-reveal>
      <span class="badge__tag"><span class="dot"></span>{c.badge}</span>{c.badgeText} →
    </a>
    <div class="hero2__cmd" aria-hidden="true"><span class="tk tk--p">$</span> <span data-hero-cmd data-text={c.cmd}>{c.cmd}</span><i class="hero2__caret"></i></div>
    <h1 class="hero2__h1" data-hero-h1>
      <span class="h1-tag" aria-hidden="true">&lt;h1&gt;</span>
      <span class="hero2__l1" data-type>{c.h1a}</span>
      <span class="hero2__l2 grad-text" data-compile data-src={c.code}>{c.h1b}</span>
      <span class="h1-tag h1-tag--end" aria-hidden="true">&lt;/h1&gt;</span>
    </h1>
    <p class="lead" data-reveal style="--d:300ms">{c.lead}</p>
    <div class="hero__ctas" data-reveal style="--d:380ms">
      <a href={href("start", lang)} class="btn btn--primary" data-magnetic>{t.start} <span class="arrow">→</span></a>
      <a href="#proyectos" class="btn btn--ghost" data-magnetic>{c.see}</a>
    </div>
  </div>

  <div class="showcase" data-showcase data-reveal style="--d:450ms">
    <div class="showcase__glow"></div>
    <div class="showcase__stage">
      {deck.map((d, i) => (
        <article class={`sc-card sc-card--${d.kind}`} data-card={i} data-pos={i} style={`--acc:${d.accent}`}>
          <a class="sc-card__link" href={href("case", lang, d.slug)} tabindex="-1" aria-label={d.name}></a>
          <span class="sc-tag"><span class="tk tk--p">&lt;</span>{d.tag}<span class="tk tk--p"> /&gt;</span></span>
          {d.kind === "phone" ? (
            <div class="sc-phone">
              <i class="sc-phone__island"></i>
              <div class="sc-phone__screens">
                {d.shots.map((src: string, k: number) => <img class={k === 0 ? "is-on" : undefined} src={base + src} srcset={srcset2x(src)} alt="" width="600" height="1298" loading="eager" decoding="async" />)}
              </div>
            </div>
          ) : (
            <div class="sc-browser">
              <div class="sc-browser__bar"><i></i><i></i><i></i><span>{d.url}</span></div>
              <div class="sc-browser__view"><img class="sc-scroll" src={base + d.page} srcset={srcset2x(d.page)} alt="" width="640" height={d.h} loading="eager" decoding="async" style={`--h:${d.h}`} /></div>
            </div>
          )}
          <footer class="sc-meta"><span class="sc-dot"></span><b>{d.name}</b><small>{d.status}</small></footer>
        </article>
      ))}
    </div>
    <div class="showcase__rail" role="tablist" aria-label={lang === "es" ? "Proyectos" : "Projects"}>
      {deck.map((d, i) => <button type="button" role="tab" data-go={i} aria-selected={i === 0 ? "true" : "false"} class={i === 0 ? "is-on" : undefined}><span>{d.cmd}</span><i></i></button>)}
    </div>
  </div>
</header>
