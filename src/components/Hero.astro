---
import { ui, href, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];

const c = {
  en: {
    badge: "New", badgeText: "Lyapp is live on the App Store",
    cmd: "forklia build --from idea --to product",
    h1a: "Ideas in.", h1b: "Products out.", code: "ideas.map(build)",
    lead: "Forklia is a remote studio that designs and codes apps, websites, SEO and brand systems for teams anywhere in the world.",
    see: "See shipped work",
    chips: [["Build passed", "prod · 2s ago"], ["Lighthouse 100", "perf · a11y · seo"], ["Shipped to App Store", "Lyapp · v1.1"]],
    compiling: "compiling…", compiled: "compiled in", hot: "hot reload",
    proj: [["Lyapp", "Live on the App Store", "View case"], ["Your English Buddy", "Website · in staging", "View case"], ["Simply Andy", "Brand system · in staging", "View case"]],
  },
  es: {
    badge: "Nuevo", badgeText: "Lyapp ya está en la App Store",
    cmd: "forklia build --desde idea --hasta producto",
    h1a: "Entra una idea.", h1b: "Sale un producto.", code: "idea.compilar()",
    lead: "Forklia es un estudio remoto que diseña y programa apps, sitios web, SEO y sistemas de marca para equipos de cualquier país.",
    see: "Ver proyectos reales",
    chips: [["Build exitoso", "prod · hace 2s"], ["Lighthouse 100", "perf · a11y · seo"], ["Publicada en App Store", "Lyapp · v1.1"]],
    compiling: "compilando…", compiled: "compilado en", hot: "hot reload",
    proj: [["Lyapp", "Disponible en App Store", "Ver caso"], ["Your English Buddy", "Sitio web · en prueba", "Ver caso"], ["Simply Andy", "Sistema de marca · en prueba", "Ver caso"]],
  },
}[lang];

const pass = {
  en: {
    hint: "Drag",
    read: "01 spec · 4 sprints",
    caption: "The same pass builds the site and the app.",
    aria: "Web and mobile build. Arrow keys move from spec to production.",
    gates: ["spec", "design", "build", "prod"],
    url: "app.forklia",
    web: "Web",
    ios: "iOS",
    brief: "Brief",
    rows: ["4 sprints", "web + ios", "one product"],
    liveA: "Ideas in.",
    liveB: "Products out.",
    today: "Today",
    stamp: "128 mod · 214",
  },
  es: {
    hint: "Arrastra",
    read: "01 spec · 4 sprints",
    caption: "La misma pasada construye el sitio y la app.",
    aria: "Build web y mobile. Las flechas van de spec a producción.",
    gates: ["spec", "diseño", "build", "prod"],
    url: "app.forklia",
    web: "Web",
    ios: "iOS",
    brief: "Brief",
    rows: ["4 sprints", "web + ios", "un producto"],
    liveA: "Entra una idea.",
    liveB: "Sale un producto.",
    today: "Hoy",
    stamp: "128 mód · 214",
  },
}[lang];
---

<header class="hero2" id="top">
  <div class="hero2__float" aria-hidden="true">
    {[
      ["<App />", "f1"], ["useState(idea)", "f2"], ["</>", "f3"], ["git push origin main", "f4"],
      ["fetch('/api/launch')", "f5"], ["{ ...brand }", "f6"], ["<View>", "f7"], ["npm run build", "f8"],
      [".map(build)", "f9"], ["=> deploy()", "f10"], ["@media (max-width: 640px)", "f11"], ["200 OK", "f12"],
    ].map(([t, k]) => <span class={`fcode ${k}`} data-depth={k.length % 3 + 1}>{t}</span>)}
  </div>
  <div class="hero2__in">
    <a href={href("case", lang, "lyapp")} class="badge" data-reveal>
      <span class="badge__tag"><span class="dot"></span>{c.badge}</span>{c.badgeText} →
    </a>
    <div class="hero2__cmd" aria-hidden="true"><span class="tk tk--p">$</span> <span data-hero-cmd data-text={c.cmd}>{c.cmd}</span><i class="hero2__caret"></i></div>
    <h1 class="hero2__h1" data-hero-h1>
      <span class="h1-tag" aria-hidden="true">&lt;h1&gt;</span>
      <span class="hero2__l1" data-type>{c.h1a}</span>
      <span class="hero2__l2 grad-text" data-compile data-src={c.code}>{c.h1b}</span>
      <span class="h1-tag h1-tag--end" aria-hidden="true">&lt;/h1&gt;</span>
    </h1>
    <p class="lead" data-reveal style="--d:300ms">{c.lead}</p>
    <div class="hero__ctas" data-reveal style="--d:380ms">
      <a href={href("start", lang)} class="btn btn--primary" data-magnetic>{t.start} <span class="arrow">→</span></a>
      <a href="#proyectos" class="btn btn--ghost" data-magnetic>{c.see}</a>
    </div>
  </div>

  <div class="pass" data-pass data-reveal style="--d:450ms" tabindex="0" role="slider" aria-label={pass.aria} aria-valuemin="1" aria-valuemax="4" aria-valuenow="1" aria-valuetext={pass.read}>
    <div class="pass__stage">
      <div class="pass__devices">
        <article class="dev dev--web" aria-hidden="true">
          <span class="dev__name">{pass.web}</span>
          <div class="dev__bar"><i></i><i></i><i></i><span>{pass.url}</span></div>
          <div class="dev__screen">
            <div class="ui ui--spec"><em>{pass.brief}</em>{pass.rows.map((row) => <b>{row}</b>)}</div>
            <div class="ui ui--wire web-wire">
              <i class="w-nav"></i><i class="w-title"></i><i class="w-line"></i><i class="w-line w-line--s"></i><i class="w-btn"></i><i class="w-card"></i><i class="w-card"></i><i class="w-card"></i>
            </div>
            <div class="ui ui--fill web-fill">
              <i class="w-nav"></i><i class="w-title"></i><i class="w-line"></i><i class="w-line w-line--s"></i><i class="w-btn"></i><i class="w-card"></i><i class="w-card"></i><i class="w-card"></i>
              <span class="stamp">{pass.stamp}</span>
            </div>
            <div class="ui ui--live web-live">
              <div class="lv-nav"><b>Forklia</b><em></em></div>
              <strong>{pass.liveA}<br>{pass.liveB}</strong>
              <small></small>
              <span class="lv-btn"></span>
              <div class="lv-cards"><i></i><i></i><i></i></div>
            </div>
            <div class="pass__scan"></div>
          </div>
        </article>
        <article class="dev dev--phone" aria-hidden="true">
          <span class="dev__name">{pass.ios}</span>
          <div class="dev__screen">
            <i class="dev__island"></i>
            <div class="ui ui--spec"><em>{pass.brief}</em>{pass.rows.map((row) => <b>{row}</b>)}</div>
            <div class="ui ui--wire ph-wire">
              <i class="p-hello"></i><i class="p-card"></i><i class="p-row"></i><i class="p-row"></i><i class="p-tabs"></i>
            </div>
            <div class="ui ui--fill ph-fill">
              <i class="p-hello"></i><i class="p-card"></i><i class="p-row"></i><i class="p-row"></i><i class="p-tabs"></i>
              <span class="stamp">{pass.stamp}</span>
            </div>
            <div class="ui ui--live ph-live">
              <div class="ph-top"><b>9:41</b><em></em></div>
              <strong>{pass.today}</strong>
              <div class="ph-metric"><b>12.5h</b><i></i></div>
              <div class="ph-rows"><i></i><i></i></div>
              <div class="ph-tab"><i></i><i></i><i></i></div>
            </div>
            <div class="pass__scan"></div>
          </div>
        </article>
      </div>
      <div class="pass__rail">
        <i class="pass__track"></i>
        <i class="pass__thumb"></i>
        {pass.gates.map((name, i) => <button type="button" data-gate={i} class={i === 0 ? "is-on" : undefined}>{name}</button>)}
      </div>
    </div>
    <aside class="pass__note">
      <span class="pass__fig" data-pass-fig>01</span>
      <b data-pass-read>{pass.read}</b>
      <small>{pass.hint}</small>
      <p>{pass.caption}</p>
    </aside>
  </div>
</header>
<script src="../scripts/ship-pass.js"></script>
