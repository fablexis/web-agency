---
import { cases } from "../data/site";

interface Props {
  limit?: number;
}
const { limit = cases.length } = Astro.props;
---

<div class="cases">
  {cases.slice(0, limit).map((c, i) => (
    <article class="card case" data-reveal data-spotlight data-tilt style={`--d:${(i % 3) * 100}ms; --cc:${c.c}; --gc:${c.g}`}>
      <div class="case__art" style={`background: radial-gradient(90% 90% at 50% 0%, ${c.g}, transparent), linear-gradient(135deg, #0E1430, #140f33);`}>
        <div class="case__metric" style={`color:${c.c}`}>{c.metric}</div>
        <div class="case__mini" aria-hidden="true"><i></i><i></i><i></i></div>
      </div>
      <div class="case__body">
        <div class="case__cat">{c.cat}</div>
        <h3>{c.title}</h3>
        <p>{c.text}</p>
      </div>
    </article>
  ))}
</div>
