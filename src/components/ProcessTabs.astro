---
import { steps } from "../data/site";
import { loc, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const list = loc(steps, lang) as { title: string; text: string; c: string; icon: string }[];
const c = {
  en: {
    spec: [["Define business goals", "KPI: +40% leads in 90 days"], ["Map audience and journeys", "3 personas · 5 key flows"], ["Audit competitors and SEO", "142 prioritized keywords"], ["Information architecture", "Sitemap v1 approved"], ["MVP roadmap and scope", "4 sprints · continuous delivery"]],
    specTitle: "Spec · project your-brand", run: "▶ Run all tasks", aria: "Process stages",
    build: "→ Compiling 128 modules…", built: "✓ Optimized build · 84 KB gzip", tests: "✓ 214 tests · 0 failures · 96% coverage", shipped: "✓ Shipped to", in: "in 38s",
    kpis: [["Sessions", "+214%", "▲ vs. last year"], ["Leads", "1,284", "▲ 3.2x"], ["Google top 3", "38", "▲ keywords"]],
  },
  es: {
    spec: [["Definir objetivos de negocio", "KPI: +40% leads en 90 días"], ["Mapear audiencia y journeys", "3 perfiles · 5 flujos clave"], ["Auditar competencia y SEO", "142 keywords priorizadas"], ["Arquitectura de información", "Sitemap v1 aprobado"], ["Roadmap y alcance del MVP", "4 sprints · entrega continua"]],
    specTitle: "Spec · proyecto tu-marca", run: "▶ Ejecutar todas las tareas", aria: "Etapas del proceso",
    build: "→ Compilando 128 módulos…", built: "✓ Build optimizado · 84 KB gzip", tests: "✓ 214 tests · 0 fallos · cobertura 96%", shipped: "✓ Publicado en", in: "en 38s",
    kpis: [["Sesiones", "+214%", "▲ vs. año anterior"], ["Leads", "1,284", "▲ 3.2x"], ["Top 3 Google", "38", "▲ keywords"]],
  },
}[lang];
const growthBars = [12, 18, 16, 26, 30, 28, 42, 50, 48, 64, 72, 88];
---

<div class="proc" data-proc>
  <div class="proc__tabs" role="tablist" aria-label={c.aria} data-reveal>
    {list.map((s, i) => (
      <button class={`ptab${i === 0 ? " is-active" : ""}`} role="tab" aria-selected={i === 0 ? "true" : "false"} aria-controls={`pview-${i}`} id={`ptab-${i}`} style={`--c:${s.c}`}>
        <span class="ptab__ic">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon}></svg>
          <span class="ptab__n">{i + 1}</span>
        </span>
        <span><strong class="ptab__t">{s.title}</strong><p>{s.text}</p></span>
        <span class="ptab__bar"><i></i></span>
      </button>
    ))}
  </div>
  <div class="proc__panel" data-reveal style="--d:120ms">
    <div class="window">
      <div class="window__bar">
        <div class="window__dots"><i></i><i></i><i></i></div>
        <div class="win-tabs" id="win-tabs"><span class="is-on">spec.md</span><span>design.fig</span><span>terminal</span><span>analytics</span></div>
      </div>
    </div>
    <div class="pview spec is-active" id="pview-0" role="tabpanel" aria-labelledby="ptab-0">
      <h5>{c.specTitle}</h5>
      <ul>{c.spec.map(([t, s]) => <li><i></i><span>{t}<small>{s}</small></span></li>)}</ul>
      <span class="spec__run">{c.run}</span>
    </div>
    <div class="pview" id="pview-1" role="tabpanel" aria-labelledby="ptab-1">
      <div class="cursor-fake" id="fake-cursor"><svg width="18" height="18" viewBox="0 0 24 24" fill="#B58CFF"><path d="M3 2l18 8-8 2.5L10 21z"></path></svg><span>Fabio</span></div>
      <div class="wire" id="wire"><div class="w-nav"></div><div class="w-hero"></div><div class="w-btn"></div><div class="w-card"></div><div class="w-card"></div><div class="w-card"></div><div class="w-text"></div><div class="w-text"></div></div>
    </div>
    <div class="pview term" id="pview-2" role="tabpanel" aria-labelledby="ptab-2">
      <div class="ln"><span class="p">~/your-brand $</span> forklia build</div>
      <div class="ln m">{c.build}</div>
      <div class="ln"><div class="progress"><i></i></div></div>
      <div class="ln ok">{c.built}</div>
      <div class="ln"><span class="p">~/your-brand $</span> forklia test</div>
      <div class="ln ok">{c.tests}</div>
      <div class="ln"><span class="p">~/your-brand $</span> forklia deploy --prod</div>
      <div class="ln ok">{c.shipped} <span class="u">your-brand.com</span> {c.in}</div>
    </div>
    <div class="pview growth" id="pview-3" role="tabpanel" aria-labelledby="ptab-3">
      <div class="growth__kpis">{c.kpis.map(([a, b, d]) => <div class="kpi"><span>{a}</span><strong>{b}</strong><small>{d}</small></div>)}</div>
      <div class="growth__bars">{growthBars.map((h, i) => <i style={`--i:${i}`} data-h={h}></i>)}</div>
    </div>
  </div>
</div>
