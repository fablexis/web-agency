---
import { testimonials } from "../data/site";
import { href, loc, type Lang } from "../i18n";
import { avatarSvg } from "../lib/avatar";

interface Props { lang: Lang }
const { lang } = Astro.props;
const list = testimonials.map((t) => ({ ...loc(t, lang), avatar: avatarSvg(t.seed, t.colors, 56), mini: avatarSvg(t.seed, t.colors, 26) }));
const c = {
  en: { cmd: "git log --oneline --reviews", real: "verified client", see: "See her project", aria: "Testimonials" },
  es: { cmd: "git log --oneline --reseñas", real: "cliente verificado", see: "Ver su proyecto", aria: "Testimonios" },
}[lang];
---

<div class="tlog" data-tlog>
  <div class="tlog__stage">
    {list.map((t, i) => (
      <figure class={`tlog__q${i === 0 ? " is-active" : ""}`} id={`tq-${i}`} role="tabpanel" aria-labelledby={`tt-${i}`} hidden={i !== 0 ? true : undefined}>
        <blockquote><p data-decode>“{t.q}”</p></blockquote>
        <figcaption>
          <span class="tlog__av" set:html={t.avatar} />
          <span class="tlog__who"><b>{t.n}</b><small>{t.r}</small></span>
          {t.real && t.project && <a class="link-arrow" href={href("case", lang, t.project)}>{c.see} <span>→</span></a>}
        </figcaption>
      </figure>
    ))}
  </div>
  <div class="tlog__side">
    <div class="tlog__cmd"><span class="tk tk--p">$</span> {c.cmd}</div>
    <div class="tlog__list" role="tablist" aria-label={c.aria}>
      {list.map((t, i) => (
        <button type="button" role="tab" id={`tt-${i}`} aria-controls={`tq-${i}`} aria-selected={i === 0 ? "true" : "false"} class={i === 0 ? "is-active" : undefined}>
          <span class="tlog__node" aria-hidden="true"></span>
          <code class="tlog__sha">{t.sha}</code>
          <span class="tlog__mini" set:html={t.mini} />
          <span class="tlog__name">{t.n}<small>{t.r}</small></span>
          {i === 0 && <em class="tlog__head">HEAD</em>}
          {t.real && <em class="tlog__real">{c.real}</em>}
          <i class="tlog__prog" aria-hidden="true"><b></b></i>
        </button>
      ))}
    </div>
  </div>
</div>
