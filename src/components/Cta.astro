---
import { site } from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Listo para llevar tu marca al <span class="grad-text">siguiente nivel</span>?',
  text = "Cuéntanos tu idea desde cualquier país y te enviamos una propuesta sin compromiso en menos de 48 horas.",
} = Astro.props;
---

<section id="contacto" class="section" style="padding-top: 0;" aria-label="Iniciar un proyecto">
  <div class="wrap">
    <div class="cta" data-reveal>
      <div class="cta__in">
        <h2>¿<Fragment set:html={title} /></h2>
        <p>{text}</p>
        <div class="hero__ctas">
          <a href={`${base}cotizar/`} class="btn btn--primary" data-magnetic>Iniciar proyecto <span class="arrow">→</span></a>
          <a href={site.whatsapp} class="btn btn--ghost" data-magnetic>Hablar por WhatsApp</a>
        </div>
        <div class="cta__note"><span class="dot dot--green"></span>Respondemos en menos de 24h</div>
      </div>
    </div>
  </div>
</section>
