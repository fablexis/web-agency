---
import { site } from "../data/site";
import { ui, href, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  title?: string;
  text?: string;
}
const { lang } = Astro.props;
const t = ui[lang];
const title = Astro.props.title ?? t.ctaTitle;
const text = Astro.props.text ?? t.ctaText;
---

<section id="contacto" class="section" style="padding-top: 0;" aria-label={t.start}>
  <div class="wrap">
    <div class="cta" data-reveal>
      <div class="cta__in">
        <h2 set:html={title} />
        <p>{text}</p>
        <div class="hero__ctas">
          <a href={href("start", lang)} class="btn btn--primary" data-magnetic>{t.ctaPrimary} <span class="arrow">→</span></a>
          <a href={site.whatsapp} class="btn btn--ghost" data-magnetic>{t.ctaWhatsapp}</a>
        </div>
        <div class="cta__note"><span class="dot dot--green"></span>{t.ctaNote}</div>
      </div>
    </div>
  </div>
</section>
