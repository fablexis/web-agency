---
import { ui, href, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  eyebrow: string;
  crumb: string;
  title: string;
  lead?: string;
  violet?: boolean;
}
const { lang, eyebrow, crumb, title, lead, violet = false } = Astro.props;
---

<header class="page-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb" data-reveal>
      <a href={href("home", lang)}>~</a><span>/</span><span aria-current="page">{crumb}</span>
    </nav>
    <div class={`eyebrow${violet ? " eyebrow--violet" : ""}`} data-reveal>{eyebrow}</div>
    <h1 data-split set:html={title} />
    {lead && <p class="lead" data-reveal style="--d:200ms">{lead}</p>}
    <slot />
  </div>
</header>
