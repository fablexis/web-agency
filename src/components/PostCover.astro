---
/**
 * Generated cover art per article: an SVG scene drawn for each topic,
 * tinted with the post hue. No stock images.
 */
interface Props { slug: string; hue: number; label: string; big?: boolean }
const { slug, hue, label, big = false } = Astro.props;
const a = `hsl(${hue} 90% 62%)`, b = `hsl(${(hue + 55) % 360} 85% 68%)`, ink = "#0b0e1c", card = "#151a30", line = "rgba(255,255,255,.14)", txt = "rgba(255,255,255,.55)";
const id = `pc-${slug}`;
---

<div class={`post__cover pcover${big ? " pcover--big" : ""}`} aria-hidden="true">
  <svg viewBox="0 0 1200 630" preserveAspectRatio="xMidYMid slice" font-family="JetBrains Mono, monospace">
    <defs>
      <radialGradient id={`${id}-g`} cx="12%" cy="0%" r="95%"><stop offset="0" stop-color={a} stop-opacity=".32" /><stop offset="1" stop-color={ink} stop-opacity="0" /></radialGradient>
      <radialGradient id={`${id}-h`} cx="95%" cy="100%" r="70%"><stop offset="0" stop-color={b} stop-opacity=".22" /><stop offset="1" stop-color={ink} stop-opacity="0" /></radialGradient>
      <pattern id={`${id}-d`} width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.3" fill="rgba(255,255,255,.09)" /></pattern>
      <linearGradient id={`${id}-l`} x1="0" x2="1"><stop offset="0" stop-color={a} /><stop offset="1" stop-color={b} /></linearGradient>
    </defs>
    <rect width="1200" height="630" fill={ink} />
    <rect width="1200" height="630" fill={`url(#${id}-g)`} />
    <rect width="1200" height="630" fill={`url(#${id}-h)`} />
    <rect width="1200" height="630" fill={`url(#${id}-d)`} />

    {slug === "launch-an-mvp-in-30-days" && (
      <g class="pc">
        {[["LAUNCH", 230, 1], ["LATER", 650, 0]].map(([t, x, on]: any) => (
          <g transform={`translate(${x} 110)`}>
            <rect width="340" height="420" rx="22" fill={on ? "rgba(255,255,255,.04)" : "none"} stroke={on ? a : line} stroke-dasharray={on ? "0" : "8 8"} stroke-width="2" />
            <text x="26" y="44" font-size="20" fill={on ? a : txt} letter-spacing="3">{t}</text>
            {(on ? [210, 250, 180] : [230, 170, 260, 200]).map((w, i) => (
              <g class="pc-card" style={`--i:${i + (on ? 0 : 3)}`} transform={`translate(26 ${76 + i * 80})`} opacity={on ? 1 : 0.45}>
                <rect width="288" height="60" rx="12" fill={card} stroke={line} />
                <rect x="18" y="22" width="16" height="16" rx="4" fill={on ? a : "none"} stroke={on ? a : txt} stroke-width="2" />
                <rect x="50" y="24" width={w - 60} height="12" rx="6" fill="rgba(255,255,255,.3)" />
              </g>
            ))}
          </g>
        ))}
        <g transform="translate(1040 120)"><rect width="110" height="44" rx="22" fill={`url(#${id}-l)`} /><text x="55" y="29" font-size="20" font-weight="700" fill={ink} text-anchor="middle">v1.0</text></g>
        <path d="M575 320h60" stroke={a} stroke-width="3" stroke-dasharray="6 8" class="pc-dash" />
      </g>
    )}

    {slug === "technical-seo-in-2026" && (
      <g class="pc">
        {[["LCP", "2.1s", 0.84], ["INP", "140ms", 0.7], ["CLS", "0.05", 0.5]].map(([n, v, p]: any, i) => (
          <g transform={`translate(${190 + i * 290} 300)`}>
            <path d="M-110 0a110 110 0 0 1 220 0" fill="none" stroke="rgba(255,255,255,.08)" stroke-width="20" stroke-linecap="round" />
            <path class="pc-gauge" style={`--i:${i}`} d="M-110 0a110 110 0 0 1 220 0" fill="none" stroke="#4BE3A0" stroke-width="20" stroke-linecap="round" pathLength="100" stroke-dasharray={`${p * 100} 100`} />
            <text y="-12" font-size="44" font-weight="700" fill="#fff" text-anchor="middle">{v}</text>
            <text y="40" font-size="20" fill={txt} text-anchor="middle" letter-spacing="3">{n}</text>
          </g>
        ))}
        <g transform="translate(110 400)">
          <rect width="980" height="150" rx="18" fill={card} stroke={line} />
          <text x="30" y="46" font-size="18" fill="#7fe7ff">your-brand.com › services</text>
          <rect x="30" y="66" width="520" height="18" rx="9" fill={a} opacity=".8" />
          <rect x="30" y="100" width="860" height="12" rx="6" fill="rgba(255,255,255,.22)" />
          <rect x="30" y="122" width="640" height="12" rx="6" fill="rgba(255,255,255,.16)" />
        </g>
      </g>
    )}

    {slug === "micro-interactions-that-sell" && (
      <g class="pc" transform="translate(600 300)">
        {[0, 1, 2].map((i) => <circle class="pc-ripple" style={`--i:${i}`} r={90 + i * 70} fill="none" stroke={a} stroke-width="2" opacity={0.5 - i * 0.14} />)}
        <rect x="-190" y="-48" width="380" height="96" rx="48" fill={`url(#${id}-l)`} />
        <text y="12" font-family="Space Grotesk, sans-serif" font-size="36" font-weight="700" fill={ink} text-anchor="middle">Pay now</text>
        <g transform="translate(150 40)"><path d="M0 0l0 64 18-16 12 28 14-6-12-28 24 0z" fill="#fff" stroke={ink} stroke-width="3" stroke-linejoin="round" /></g>
        <g transform="translate(260 -120)"><circle r="34" fill="#4BE3A0" /><path d="M-14 0l9 10 19-20" fill="none" stroke={ink} stroke-width="7" stroke-linecap="round" stroke-linejoin="round" /></g>
        {["idle", "pressed", "loading", "done"].map((s, i) => (
          <g transform={`translate(${-450 + i * 120} 190)`}><rect width="100" height="34" rx="17" fill="none" stroke={i === 3 ? "#4BE3A0" : line} /><text x="50" y="23" font-size="15" fill={i === 3 ? "#4BE3A0" : txt} text-anchor="middle">{s}</text></g>
        ))}
      </g>
    )}

    {slug === "modern-stack-for-startups" && (
      <g class="pc" transform="translate(600 150)">
        {[["Astro · React Native", a, 0], ["TypeScript API", b, 1], ["Supabase · Postgres", "#4BE3A0", 2]].map(([t, c, i]: any) => (
          <g class="pc-slab" style={`--i:${i}`} transform={`translate(0 ${i * 120})`}>
            <path d="M0 0l300 80l-300 80l-300-80z" fill={c} opacity=".18" stroke={c} stroke-width="2" />
            <path d="M-300 80v26l300 80l300-80v-26" fill="none" stroke={c} stroke-width="2" opacity=".6" />
            <text y="88" font-size="24" fill="#fff" text-anchor="middle">{t}</text>
          </g>
        ))}
      </g>
    )}

    {slug === "from-visits-to-customers" && (
      <g class="pc" transform="translate(600 90)">
        {[[460, "2,000", "visits"], [330, "80", "leads"], [200, "20", "customers"]].map(([w, n, t]: any, i) => (
          <g class="pc-slab" style={`--i:${i}`} transform={`translate(0 ${i * 150})`}>
            <path d={`M${-w} 0H${w}L${w - 70} 120H${-w + 70}z`} fill={i === 2 ? `url(#${id}-l)` : "rgba(255,255,255,.05)"} stroke={i === 2 ? "none" : a} stroke-width="2" />
            <text y="72" font-family="Space Grotesk, sans-serif" font-size="44" font-weight="700" fill={i === 2 ? ink : "#fff"} text-anchor="middle">{n} <tspan font-size="20" font-family="JetBrains Mono, monospace" fill={i === 2 ? ink : txt}>{t}</tspan></text>
          </g>
        ))}
        {[0, 1].map((i) => <text x={-470 + i * 60} y={150 + i * 150} font-size="20" fill="#ff8aa0">↘ −{i ? "75" : "96"}%</text>)}
      </g>
    )}

    {slug === "apps-that-feel-alive" && (
      <g class="pc">
        <g transform="translate(250 60)">
          <rect width="270" height="540" rx="46" fill="#1b2240" stroke={line} stroke-width="3" />
          <rect x="70" y="20" width="130" height="38" rx="19" fill="#000" />
          <circle cx="92" cy="39" r="6" fill="#E8805A" class="pc-pulse" />
          <text x="170" y="46" font-size="18" fill="#F6C9B2" text-anchor="end">12:35</text>
          <text x="135" y="200" font-family="Space Grotesk, sans-serif" font-size="78" font-weight="700" fill="#fff" text-anchor="middle">9:41</text>
          <rect x="28" y="250" width="214" height="80" rx="22" fill="rgba(255,255,255,.12)" />
          <circle cx="58" cy="290" r="8" fill="#E8805A" />
          <rect x="78" y="282" width="80" height="14" rx="7" fill="rgba(255,255,255,.5)" />
          <text x="222" y="297" font-size="18" fill="#fff" text-anchor="end">12:35</text>
        </g>
        <g transform="translate(640 140)">
          <rect width="360" height="110" rx="24" fill={card} stroke={line} />
          <text x="30" y="48" font-size="18" fill={txt}>LIVE ACTIVITY</text>
          <text x="30" y="84" font-family="Space Grotesk, sans-serif" font-size="30" font-weight="700" fill="#fff">Nap · 12:35</text>
          <rect y="150" width="360" height="110" rx="24" fill={card} stroke={line} />
          <text x="30" y="198" font-size="18" fill={txt}>TAP TARGET</text>
          <text x="30" y="234" font-family="Space Grotesk, sans-serif" font-size="30" font-weight="700" fill="#fff">44 × 44 pt</text>
          <rect y="300" width="360" height="110" rx="24" fill={card} stroke={line} />
          <text x="30" y="348" font-size="18" fill={txt}>FEEDBACK</text>
          <text x="30" y="384" font-family="Space Grotesk, sans-serif" font-size="30" font-weight="700" fill="#4BE3A0">&lt; 100 ms</text>
        </g>
      </g>
    )}
  </svg>
  <span>{label}</span>
</div>
