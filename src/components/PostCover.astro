---
/**
 * Generated cover art: a deterministic SVG per article. Tetromino-like blocks,
 * a few "lines of code" and a glyph for the topic, tinted by the post hue.
 */
interface Props { slug: string; hue: number; label: string; glyph?: string; big?: boolean }
const { slug, hue, label, big = false } = Astro.props;
const glyphs: Record<string, string> = {
  "launch-an-mvp-in-30-days": "v1.0", "technical-seo-in-2026": "</>", "micro-interactions-that-sell": "( )",
  "modern-stack-for-startups": "{ }", "from-visits-to-customers": "%", "apps-that-feel-alive": "◉",
};
const glyph = Astro.props.glyph ?? glyphs[slug] ?? "//";
let seed = [...slug].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
const rnd = () => ((seed = (seed * 1103515245 + 12345) >>> 0) / 4294967296);
const c1 = `hsl(${hue} 90% 62%)`, c2 = `hsl(${(hue + 60) % 360} 85% 66%)`, c3 = `hsl(${(hue + 200) % 360} 30% 92%)`;
const cols = 7, rows = 6, s = 46;
const blocks: { x: number; y: number; c: string; i: number }[] = [];
const heights = Array.from({ length: cols }, () => 1 + Math.floor(rnd() * (rows - 1)));
heights.forEach((h, x) => { for (let y = rows - h; y < rows; y++) blocks.push({ x, y, c: [c1, c2, c3][Math.floor(rnd() * 3)], i: blocks.length }); });
const lines = Array.from({ length: 6 }, (_, i) => ({ w: 90 + rnd() * 240, x: (i % 3 === 0 ? 0 : 28) + 0, c: [c1, c2, "rgba(255,255,255,.35)"][i % 3] }));
const id = `pc-${slug}`;
---

<div class={`post__cover pcover${big ? " pcover--big" : ""}`} aria-hidden="true">
  <svg viewBox="0 0 1200 630" preserveAspectRatio="xMidYMid slice">
    <defs>
      <radialGradient id={`${id}-g`} cx="15%" cy="0%" r="90%"><stop offset="0" stop-color={c1} stop-opacity=".35" /><stop offset="1" stop-color="#0b0e1c" stop-opacity="0" /></radialGradient>
      <pattern id={`${id}-d`} width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.4" fill="rgba(255,255,255,.12)" /></pattern>
    </defs>
    <rect width="1200" height="630" fill="#0b0e1c" />
    <rect width="1200" height="630" fill={`url(#${id}-g)`} />
    <rect width="1200" height="630" fill={`url(#${id}-d)`} />
    <g transform="translate(70 120)" font-family="JetBrains Mono, monospace">
      {lines.map((l, i) => (
        <g class="pcover__ln" style={`--i:${i}`}>
          <text x="0" y={i * 46 + 16} fill="rgba(255,255,255,.22)" font-size="18">{String(i + 1).padStart(2, "0")}</text>
          <rect x={46 + l.x} y={i * 46} width={l.w} height="18" rx="9" fill={l.c} opacity=".55" />
        </g>
      ))}
      <text x="0" y="370" fill={c1} font-size="64" font-weight="700" class="pcover__glyph">{glyph}</text>
    </g>
    <g transform={`translate(${1200 - cols * s - 70} ${630 - rows * s - 60})`}>
      {blocks.map((b) => <rect class="pcover__b" style={`--i:${b.i}`} x={b.x * s} y={b.y * s} width={s - 6} height={s - 6} rx="9" fill={b.c} />)}
    </g>
  </svg>
  <span>{label}</span>
</div>
